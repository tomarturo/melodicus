# Copy to .env.local and fill in. Vite only exposes variables prefixed with VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: Google Analytics. Leave empty to send nothing; set it in Vercel's
# Production environment only, so dev and preview traffic stay out of GA.
VITE_GA_MEASUREMENT_ID=

# Server-only: used by the api/ functions (YouTube search and video details),
# never sent to the browser. No VITE_ prefix, so Vite never bundles it.
YOUTUBE_API_KEY=
